# Indeed Apply Module Configuration

# Your shared API secret from Indeed Apply integration settings
# Get this from your Indeed Employer account -> Indeed Apply integration settings
INDEED_APPLY_API_SECRET="your-api-secret-here"

# DEPRECATED: HMAC-SHA1 signature verification is enforced automatically whenever
# INDEED_APPLY_API_SECRET is set (invalid/missing signatures return HTTP 401).
# This flag only opts in to verification before a secret is configured and has no
# effect once a secret is present. Leave unset on new installs.
INDEED_APPLY_REQUIRE_SIGNATURE="false"